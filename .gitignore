# Secrets / environment
.env
.env.*
!.env.example

# PDFs de catálogo — os pesados (linha pesada, dezenas de MB) ficam de fora;
# os de leves/utilitários são versionados p/ reprodutibilidade do `motor pdf`.
catalog_pdf/*
!catalog_pdf/aff000426lancamentos-ano-2025tabela_f7.pdf

# Databases (too large for GitHub, regenerable)
*.db
*.db.bak*
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# Scratch / working artifacts
scratch_*.log
scratch_*.py
scratch_shots/
*.log

# Playwright persistent profile (scraper) e cache raspado
.ml_profile/
ml_cache.db*

# Local Claude settings
.claude/settings.local.json
.claude/*.tmp.*

# OS
.DS_Store
Thumbs.db

# índice de manuais (gerado por `python -m motor manuals`)
manuals.db
